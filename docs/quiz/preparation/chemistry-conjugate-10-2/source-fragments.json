    "exercise-3-2": {
      "th": "<div class=\"question-item official\" data-print-keep><p class=\"question-label\">แบบฝึกหัด 10.2 · ข้อ 3.2</p><div class=\"question-prompt\">เขียนคู่กรดของ <span class=\"species\">NH<sub>3</sub></span></div><div data-sheet-slot=\"exercise-3-2\" data-sheet-size=\"medium\" data-sheet-layout=\"block\" data-sheet-label-th=\"แบบฝึกหัด 10.2 · ข้อ 3.2\" data-sheet-label-en=\"Exercise 10.2 · Q3.2\" style=\"--sheet-print-height:20mm\"><div data-sheet-answer><span class=\"species\">NH<sub>4</sub><sup>+</sup></span> ได้จาก <span class=\"species\">NH<sub>3</sub></span> รับ H⁺ หนึ่งตัว ค่าประจุเปลี่ยนจาก 0 เป็น +1</div></div></div>",
      "en": "<div class=\"question-item official\" data-print-keep><p class=\"question-label\">Exercise 10.2 · Q3.2</p><div class=\"question-prompt\">Write the conjugate acid of <span class=\"species\">NH<sub>3</sub></span>.</div><div data-sheet-slot=\"exercise-3-2\" data-sheet-size=\"medium\" data-sheet-layout=\"block\" data-sheet-label-th=\"แบบฝึกหัด 10.2 · ข้อ 3.2\" data-sheet-label-en=\"Exercise 10.2 · Q3.2\" style=\"--sheet-print-height:20mm\"><div data-sheet-answer><span class=\"species\">NH<sub>4</sub><sup>+</sup></span> forms when <span class=\"species\">NH<sub>3</sub></span> gains one H⁺. The charge changes from 0 to +1.</div></div></div>"
