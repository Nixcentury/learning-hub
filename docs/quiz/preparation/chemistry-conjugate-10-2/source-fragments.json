    "exercise-3-4": {
      "th": "<div class=\"question-item official\" data-print-keep><p class=\"question-label\">แบบฝึกหัด 10.2 · ข้อ 3.4</p><div class=\"question-prompt\">เขียนคู่กรดของ <span class=\"species\">CN<sup>−</sup></span></div><div data-sheet-slot=\"exercise-3-4\" data-sheet-size=\"medium\" data-sheet-layout=\"block\" data-sheet-label-th=\"แบบฝึกหัด 10.2 · ข้อ 3.4\" data-sheet-label-en=\"Exercise 10.2 · Q3.4\" style=\"--sheet-print-height:20mm\"><div data-sheet-answer><span class=\"species\">HCN</span> ได้จาก <span class=\"species\">CN<sup>−</sup></span> รับ H⁺ หนึ่งตัว ค่าประจุเปลี่ยนจาก −1 เป็น 0</div></div></div>",
      "en": "<div class=\"question-item official\" data-print-keep><p class=\"question-label\">Exercise 10.2 · Q3.4</p><div class=\"question-prompt\">Write the conjugate acid of <span class=\"species\">CN<sup>−</sup></span>.</div><div data-sheet-slot=\"exercise-3-4\" data-sheet-size=\"medium\" data-sheet-layout=\"block\" data-sheet-label-th=\"แบบฝึกหัด 10.2 · ข้อ 3.4\" data-sheet-label-en=\"Exercise 10.2 · Q3.4\" style=\"--sheet-print-height:20mm\"><div data-sheet-answer><span class=\"species\">HCN</span> forms when <span class=\"species\">CN<sup>−</sup></span> gains one H⁺. The charge changes from −1 to 0.</div></div></div>"
