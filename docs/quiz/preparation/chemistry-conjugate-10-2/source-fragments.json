    "exercise-3-3": {
      "th": "<div class=\"question-item official\" data-print-keep><p class=\"question-label\">แบบฝึกหัด 10.2 · ข้อ 3.3</p><div class=\"question-prompt\">เขียนคู่กรดของ <span class=\"species\">H<sub>2</sub>O</span></div><div data-sheet-slot=\"exercise-3-3\" data-sheet-size=\"medium\" data-sheet-layout=\"block\" data-sheet-label-th=\"แบบฝึกหัด 10.2 · ข้อ 3.3\" data-sheet-label-en=\"Exercise 10.2 · Q3.3\" style=\"--sheet-print-height:20mm\"><div data-sheet-answer><span class=\"species\">H<sub>3</sub>O<sup>+</sup></span> ได้จาก <span class=\"species\">H<sub>2</sub>O</span> รับ H⁺ หนึ่งตัว ค่าประจุเปลี่ยนจาก 0 เป็น +1</div></div></div>",
      "en": "<div class=\"question-item official\" data-print-keep><p class=\"question-label\">Exercise 10.2 · Q3.3</p><div class=\"question-prompt\">Write the conjugate acid of <span class=\"species\">H<sub>2</sub>O</span>.</div><div data-sheet-slot=\"exercise-3-3\" data-sheet-size=\"medium\" data-sheet-layout=\"block\" data-sheet-label-th=\"แบบฝึกหัด 10.2 · ข้อ 3.3\" data-sheet-label-en=\"Exercise 10.2 · Q3.3\" style=\"--sheet-print-height:20mm\"><div data-sheet-answer><span class=\"species\">H<sub>3</sub>O<sup>+</sup></span> forms when <span class=\"species\">H<sub>2</sub>O</span> gains one H⁺. The charge changes from 0 to +1.</div></div></div>"
