{
  "name": "learning-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.js --port 3000",
    "build": "pnpm validate:content && tsc --noEmit && vite build --config vite.config.js && node scripts/verify-pages-build.mjs",
    "preview": "vite preview --config vite.config.js",
    "test:unit": "node --test --test-isolation=none scripts/classroom-access.test.mjs scripts/classroom-service.test.mjs scripts/content-tool.test.mjs scripts/chapter-overview.test.mjs scripts/html-math.test.mjs scripts/notebook-backup.test.mjs scripts/quiz-drag.test.mjs scripts/quiz-evidence-resume.test.mjs scripts/quiz-number.test.mjs scripts/quiz-resume.test.mjs scripts/test-quiz-storage-bridge.mjs",
    "test:overview:browser": "node scripts/test-chapter-overview-browser.mjs",
    "test:pages": "node scripts/test-pages-migration-browser.mjs",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-activity-content.mjs",
    "test:resume": "node --test --test-isolation=none scripts/quiz-resume.test.mjs scripts/test-quiz-storage-bridge.mjs scripts/quiz-evidence-resume.test.mjs",
    "test:resume:browser": "node scripts/test-quiz-resume-browser.mjs",
    "test:number": "node --test scripts/quiz-number.test.mjs",
    "test:navigation": "node --test scripts/content-tool.test.mjs",
    "test:navigation:browser": "node scripts/test-content-navigation-browser.mjs",
    "test:classroom": "node --test --test-isolation=none scripts/classroom-access.test.mjs scripts/classroom-service.test.mjs",
    "test:classroom:browser": "node scripts/test-classroom-browser.mjs",
    "test:classroom:rules": "node --test --test-isolation=none scripts/classroom-rules.test.mjs",
    "test:classroom:rooms": "node scripts/test-classroom-rooms-browser.mjs",
    "test:notebook": "node --test scripts/notebook-backup.test.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
